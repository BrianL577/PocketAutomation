POCKET_API_KEY=pk_xxx
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Recap integration - optional. Without these, the workspace dropdown on
# each meeting shows a "not connected" notice instead of live workspaces,
# and sends simply skip the Recap push.
# RECAP_BASE_URL is the domain your Recap deployment is hosted at.
# RECAP_API_KEY is a personal API key from Recap's Account settings ->
# "Personal API keys" - it can upload to any workspace its owner has
# access to, checked live on every call.
RECAP_BASE_URL=
RECAP_API_KEY=

# These are auto-populated by Vercel when you create/link a KV store -
# you don't need to set them by hand if deploying on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
